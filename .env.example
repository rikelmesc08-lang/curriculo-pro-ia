# ---------------------------------------------------------------------------
# CurrículoPro IA — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha o que precisar.
#
# NENHUMA VARIÁVEL AQUI TEM PREFIXO `NEXT_PUBLIC_`, e isso é de propósito: esse
# prefixo faz o Next embutir o valor no pacote que o navegador baixa. Tudo
# neste projeto é lido apenas em código de servidor.
#
# O PROJETO RODA SEM NENHUMA DESTAS VARIÁVEIS. Com o arquivo vazio, você tem:
#   - armazenamento em arquivo local (.data/db.json)
#   - IA em modo demonstração, claramente identificado na interface
# Isso serve para desenvolvimento. Para colocar no ar, preencha Supabase e IA.
# ---------------------------------------------------------------------------


# --- Inteligência artificial ------------------------------------------------

# Chave da API Gemini, do Google. É a ÚNICA variável necessária para ligar a IA
# de verdade, e a camada gratuita não pede cartão de crédito.
#
# Onde obter (leva um minuto):
#   1. Acesse https://aistudio.google.com/apikey
#   2. Entre com sua conta Google
#   3. Clique em "Create API key" e escolha ou crie um projeto
#   4. Copie a chave e cole na linha abaixo
#
# Sem ela, o app entra em modo demonstração: nenhuma IA é chamada e todo
# resultado aparece marcado como demonstração na tela.
GEMINI_API_KEY=

# Modelo usado. O padrão é gemini-3.6-flash, escolhido medindo a análise
# completa deste produto (ago/2026): 3/3 chamadas bem-sucedidas, 22,5s cada. O
# gemini-3.7-flash é bem mais rápido (~7s) mas voltou "high demand" em 1 de cada
# 3 chamadas; o gemini-3.5-flash é estável porém lento (~57s).
# GEMINI_MODEL=gemini-3.6-flash

# Força o provedor: "gemini", "anthropic" ou "demo". Sem isto, o app decide pela
# presença das chaves. Útil para conferir o modo demonstração com a chave
# presente.
# AI_PROVIDER=demo

# Provedor alternativo, para quem já tem crédito na Anthropic. NÃO É NECESSÁRIO:
# o app funciona inteiro sem isto, e nada exige conta lá.
# Obtenha em https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5


# --- Controle de custo da IA ------------------------------------------------
#
# Estes limites existem porque uma tela de IA autenticada e sem teto é uma conta
# de API aberta para qualquer pessoa que tenha um login e um laço de repetição.
# Os padrões são folgados para uso humano e apertados para script — mexa só se
# souber por quê.

# Chamadas de IA por usuário por hora. Padrão: 15.
# AI_HOURLY_LIMIT=15

# Chamadas de IA por usuário por dia. Padrão: 40.
# AI_DAILY_LIMIT=40

# Por quantos minutos a mesma pergunta reaproveita a resposta já calculada.
# Padrão: 720 (12 horas). Zero desliga o cache — e multiplica seu consumo.
# AI_CACHE_MINUTES=720

# Tranca a versão completa da análise atrás do plano pago ("on" liga).
#
# PADRÃO DESLIGADO, de propósito: enquanto o checkout não existir, ligar isto põe
# um cadeado numa porta sem chave — a pessoa clica em "desbloquear" e chega numa
# tela que diz que a cobrança não está ativa. Todo o mecanismo de corte já está
# implementado e coberto por teste; ligue no dia em que o pagamento entrar no ar.
# AI_PAYWALL=on


# --- Banco de dados ---------------------------------------------------------

# "local" (arquivo JSON, só desenvolvimento) ou "supabase".
# Sem isto, o app usa supabase se as variáveis abaixo existirem, e local se não
# existirem. O driver local é BLOQUEADO em produção — disco de plataforma
# serverless é efêmero e os dados dos usuários sumiriam sem erro nenhum.
# DB_DRIVER=local

# Onde o driver local grava. Relativo à raiz do projeto.
# LOCAL_DATA_DIR=.data

# Projeto Supabase. Rode docs/schema.sql no editor SQL antes de usar.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave service_role. OBRIGATÓRIA SE VOCÊ LIGAR A COBRANÇA.
#
# Todo acesso normal passa pela RLS do usuário logado. Esta chave é a exceção, e
# tem um usuário só: o webhook de pagamento (`src/lib/db/payments.ts`). Ele não
# tem sessão — quem o chama é o Mercado Pago, não uma pessoa — e precisa marcar
# a compra e liberar o plano de alguém que ele não está autenticado como.
#
# ELA IGNORA A RLS POR COMPLETO. Nunca a exponha em variável com prefixo
# NEXT_PUBLIC_, nunca a mande para o navegador, e nunca a use fora daquele
# arquivo.
# SUPABASE_SERVICE_ROLE_KEY=


# --- Sessão -----------------------------------------------------------------

# Segredo que assina o cookie de sessão do driver local. Em desenvolvimento há
# um valor padrão; em produção a ausência derruba o boot de propósito.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --- Site -------------------------------------------------------------------

# URL pública do site, COM protocolo e sem barra no fim.
#
# OBRIGATÓRIA EM PRODUÇÃO. Sem ela, o app sobe assim mesmo — mas as URLs
# canônicas, a prévia de link (Open Graph) e o link de recuperação de senha do
# Supabase apontam todos para http://localhost:3000. O log traz um aviso em
# produção; ele é fácil de não ver.
SITE_URL=http://localhost:3000


# --- Pagamento (Mercado Pago) -----------------------------------------------
#
# O CHECKOUT SÓ APARECE COM AS DUAS VARIÁVEIS ABAIXO PREENCHIDAS. Sem elas, a
# tela de plano diz que a cobrança não está ativa — nunca mostra um botão que
# falha depois do clique.
#
# Antes de preencher, leia docs/pagamento-mercado-pago.md: há dois passos que
# não são no código (rodar a migração do banco e apontar o webhook), e sem eles
# a pessoa paga e não recebe o acesso.

# Access token da sua aplicação no Mercado Pago.
# Painel: https://www.mercadopago.com.br/developers/panel
# Use o token de TESTE enquanto estiver testando; o de produção cobra de verdade.
MERCADOPAGO_ACCESS_TOKEN=

# Segredo do webhook, gerado na mesma tela em que você cadastra a URL de
# notificação. NÃO é o access token.
#
# É o que prova que uma notificação veio mesmo do Mercado Pago. Sem ele o
# webhook recusa tudo — de propósito: a URL não é segredo, e sem verificação
# qualquer POST viraria um "pagamento aprovado".
MERCADOPAGO_WEBHOOK_SECRET=

# Preço em CENTAVOS, inteiro. Padrão: 2790 (R$ 27,90).
# CHECKOUT_PRICE_CENTS=2790

# A chave service_role passa a SER NECESSÁRIA quando a cobrança liga: é ela que
# o webhook usa para marcar a compra e liberar o plano. O webhook não tem sessão
# de usuário — quem chama é o Mercado Pago.
# (declarada acima, na seção de banco de dados)
